// PALETTE_* are exported by ../../../linux/rofi.nix. The fallbacks cover
// processes that don't have the session variables.

* {
	background-color: transparent;
	text-color: env(PALETTE_BASE0, #9fabad);
}

window {
	width: 700px;
	height: 400px;
	border: 1px;
	border-color: env(PALETTE_BASE0, #9fabad);
	border-radius: 7px;
	background-color: env(PALETTE_BASE03, #002d38);
	padding: 10px;
}

mainbox {
	spacing: 5px;
	children: [ inputbar, listview ];
}

inputbar {
	padding: 4px 13px;
	children: [ entry ];
}

entry {
	vertical-align: 0.5;
}

listview {
	columns: 2;
	scrollbar: false;
	spacing: 4px;
}

element {
	padding: 4px;
	spacing: 10px;
	border-radius: 7px;
	children: [ element-icon, element-text ];
}

element-icon {
	size: 24px;
	vertical-align: 0.5;
}

element-text {
	vertical-align: 0.5;
	text-color: inherit;
}

element selected {
	background-color: env(PALETTE_BASE02, #073541);
	text-color: env(PALETTE_CYAN500, #2aa298);
}
