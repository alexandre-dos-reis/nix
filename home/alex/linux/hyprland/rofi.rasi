/* Translated from the wofi.css this replaced: same 7px radius, 1px border and
 * 700x400 box. Colors come in through pkgs.replaceVars in default.nix. */
* {
  background-color: transparent;
  text-color: @fgColor@;
  font: "@font@ 12";
}

window {
  width: 700px;
  height: 400px;
  border: 1px;
  border-color: @fgColor@;
  border-radius: 7px;
  background-color: @bgColor@;
  padding: 10px;
}

mainbox {
  spacing: 5px;
  children: [inputbar, listview];
}

inputbar {
  padding: 4px 13px;
  spacing: 8px;
  children: [entry];
}

entry {
  font: "@font@ Bold 12";
  placeholder: "";
  vertical-align: 0.5;
}

listview {
  columns: 2;
  scrollbar: false;
  spacing: 4px;
  border: 4px;
  border-color: transparent;
}

element {
  padding: 4px;
  spacing: 10px;
  border-radius: 7px;
  children: [element-icon, element-text];
}

element-icon {
  size: 24px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

element selected {
  background-color: @mgColor@;
  text-color: @selectedColor@;
}
